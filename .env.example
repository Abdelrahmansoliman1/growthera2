# Resend API key (resend.com → API Keys)
RESEND_API_KEY=
# Sender — must be on a domain verified in Resend (use onboarding@resend.dev for testing)
CONTACT_FROM=Growth Era Website <website@growtheraeg.com>
# Where form submissions are delivered
CONTACT_TO=info@growtheraeg.com
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
